generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LedgerAccountType {
  MERCHANT_MAIN
  PAYBRIDGE_SETTLEMENT
  CUSTOMER_CLEARING
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Merchant {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  apiKeys         ApiKey[]
  transactions    Transaction[]
  idempotencyKeys IdempotencyKey[]
  webhookEndpoints WebhookEndpoint[]
  ledgerAccounts  LedgerAccount[]

  @@map("merchants")
}

model ApiKey {
  id          String    @id @default(uuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  keyHash     String    @unique
  prefix      String
  name        String    @default("Default API Key")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

model Transaction {
  id             String            @id @default(uuid())
  reference      String            @unique
  merchantId     String
  merchant       Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  amount         BigInt            // Stored in the smallest currency unit (e.g. kobo for NGN)
  currency       String            @default("NGN")
  status         TransactionStatus @default(PENDING)
  customerEmail  String
  callbackUrl    String?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  ledgerEntries  LedgerEntry[]

  @@index([merchantId])
  @@index([status])
  @@map("transactions")
}

model IdempotencyKey {
  id            String    @id @default(uuid())
  key           String
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  requestPath   String
  requestParams Json?
  responseCode  Int?
  responseBody  Json?
  lockedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@unique([merchantId, key])
  @@map("idempotency_keys")
}

model LedgerAccount {
  id          String            @id @default(uuid())
  merchantId  String?
  merchant    Merchant?         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  accountType LedgerAccountType
  currency    String            @default("NGN")
  balance     BigInt            @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  entries     LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String?
  transaction   Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  accountId     String
  account       LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entryType     LedgerEntryType
  amount        BigInt
  description   String
  createdAt     DateTime        @default(now())

  @@map("ledger_entries")
}

model WebhookEndpoint {
  id          String            @id @default(uuid())
  merchantId  String
  merchant    Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  url         String
  secret      String            // Secret used for HMAC-SHA256 signing
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  deliveries  WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String                @id @default(uuid())
  endpointId   String
  endpoint     WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  signature    String
  status       WebhookDeliveryStatus @default(PENDING)
  httpStatus   Int?
  responseBody String?
  attemptCount Int                   @default(0)
  maxAttempts  Int                   @default(5)
  nextRetryAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status])
  @@map("webhook_deliveries")
}
